# ---------------------------------------------------------------------------
# Academic Prepare — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# In production, set these in the Vercel project settings, not in the repo.
# ---------------------------------------------------------------------------

# --- Database (Neon serverless Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection used by Prisma Migrate. On Neon this is the
# "direct" endpoint. Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the deployment. Vercel sets this automatically in prod; set for local dev.
AUTH_URL="http://localhost:3000"

# --- AI provider (Anthropic Claude) ---
# The default AIProvider implementation. Server-side only — never expose to the client.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional overrides.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- File storage (Vercel Blob) ---
# Created automatically when you add Blob storage to the Vercel project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- App config ---
# Max upload size in bytes (default 15 MB).
MAX_UPLOAD_BYTES="15728640"
